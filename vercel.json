{
  "framework": "vite",
  "buildCommand": "yarn build",
  "installCommand": "yarn install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://storage-backend-git-feature-warehous-062e33-igorlyakhs-projects.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://storage-backend-git-feature-warehous-062e33-igorlyakhs-projects.vercel.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
